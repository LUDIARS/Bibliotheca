# Bibliotheca .env.example
#
# 通常は **Infisical (= .env.secrets の machine identity 経由)** が信頼源で、 ここの値は
# dev 一時 override 用。 env-bootstrap は既存 process.env 値を上書きしないので、
# このファイルにキーを書くと Infisical 値を override する点に注意。
#
# 起動コマンド:
#   npm run dev   (= tsx --env-file-if-exists=.env.secrets --env-file-if-exists=.env)

# Listen port (loopback only)
# 17500 は Windows で Dropbox LAN sync が squat するので 17501 を採用
# BIBLIOTHECA_PORT=17501

# SQLite + cached metadata の保存先 (= repo root の data/、 gitignore 済)
# BIBLIOTHECA_DATA=./data

# Cernere base URL (PASETO public key fetch + login redirect)
# 本番 = Infisical で management。 dev override は明示的にここに書く
# CERNERE_BASE_URL=

# このサービス自身の public URL (PASETO audience claim)
# BIBLIOTHECA_PUBLIC_URL=

# Cernere project key (Cernere admin UI で発行)
# BIBLIOTHECA_PROJECT_KEY=bibliotheca

# Admin user IDs (= Cernere user sub をカンマ区切り)。
# 返却操作はこのリストの user のみ実行可能。
BIBLIOTHECA_ADMIN_IDS=
