# Bibliotheca env (copy to .env and override as needed)

# HTTP listen port (loopback)
# 17500 は Dropbox LAN sync が squat するので 17501 を採用 (Windows)
BIBLIOTHECA_PORT=17501

# Data directory (SQLite + cached metadata)
BIBLIOTHECA_DATA=./data

# Cernere base URL (PASETO public key fetch + login redirect)
CERNERE_BASE_URL=http://localhost:8080

# This service's own public URL (PASETO audience claim)
BIBLIOTHECA_PUBLIC_URL=http://localhost:17501

# Cernere project key (issued in Cernere admin UI)
BIBLIOTHECA_PROJECT_KEY=bibliotheca

# Admin user IDs (comma separated Cernere sub claims).
# 返却操作はこのリストの user のみ実行可能。
BIBLIOTHECA_ADMIN_IDS=
